# ==============================================================================
# Logistics Resilience Network (LRN) - Environment Variables Configuration
# ==============================================================================

# Server Network Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# JWT Authentication & Cryptographic Secrets
JWT_SECRET=lrn_resilience_jwt_secret_hackathon_2026_super_secure_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# Database 1: Neo4j Graph Database (Vehicle -> Route -> Delivery -> Customer)
# Local Docker or Cloud Neo4j AuraDB (e.g. neo4j+s://xxxx.databases.neo4j.io)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lrn_graph_password_2026

# Database 2: SQL Adaptive Learning Database (PostgreSQL or SQLite fallback)
# For Supabase / Render / AWS RDS PostgreSQL:
DATABASE_URL=postgresql://lrn_admin:lrn_pg_secret_2026@localhost:5432/lrn_adaptive_learning
# If DATABASE_URL is unset, LRN defaults to local SQLite: database/adaptive_learning.db

# ESP32 SOS Hardware Gateway
ESP32_GATEWAY_PORT=8000
ESP32_SHARED_SECRET=lrn_esp32_hardware_mesh_token_2026
